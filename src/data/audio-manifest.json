    {
      "id": "sfx-hatch",
      "name": "逃生舱密封提示",
      "type": "sfx",
      "file": "audio/cues/hatch_seal.ogg",
      "duration": 1.6,
      "synth": { "kind": "door", "freqs": [130.81, 196, 261.63] },
